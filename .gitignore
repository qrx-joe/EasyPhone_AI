# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# OpenPrd dynamic outputs (re-generated on every verify; keep config + specs + evidence)
.openprd/quality/reports/
.openprd/state/events.jsonl
.openprd/harness/drift-report.json
.openprd/harness/run-state.json
.openprd/engagements/

# OpenPrd multi-agent adapters (we don't use Codex/Cursor, keep the dirs only locally)
.codex/
.cursor/
