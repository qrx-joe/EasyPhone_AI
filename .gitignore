# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 但保留 .env.example 入库,作为环境变量文档载体(secrets-vault pattern)。
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# OpenPrd dynamic outputs (re-generated on every verify; keep config + specs + evidence)
.openprd/quality/reports/
.openprd/state/events.jsonl
.openprd/harness/drift-report.json
.openprd/harness/run-state.json
.openprd/engagements/

# OpenPrd 会话级运行时状态(每轮对话都变;快照 state/versions/ 与 specs 仍入库)
.openprd/harness/events.jsonl
.openprd/harness/iterations.jsonl
.openprd/harness/hook-state.json
.openprd/harness/turn-state.json
.openprd/harness/requirement-gate.json
.openprd/harness/requirement-gates/
.openprd/harness/research-gate.json
.openprd/harness/research-gates/
.openprd/harness/session-bindings/
.openprd/harness/session-states/
.openprd/state/current.json
.openprd/state/task-graph.json
.openprd/state/version-index.json
.openprd/knowledge/index.json
.openprd/knowledge/candidates/
.openprd/knowledge/drafts/
.openprd/knowledge/review-signals.jsonl
.openprd/growth/
.openprd/reviews/
.openprd/design/

# OpenPrd multi-agent adapters (we don't use Codex/Cursor, keep the dirs only locally)
.codex/
.cursor/

# 本地评审/构建产物(不入库)
_pr1_review.diff
android-apk/

# 本地工具/运行时噪音(纯本地,不入库)
.pnpm-store/
.dev-server.log
.tmp/

# 演示视频剪辑工程(体积大 + 含 node_modules;视频成品走 B 站,源工程不入库)
demo-video/

# 吉祥物 PNG 设计稿(public/brand/ 已有 SVG 矢量版作为唯一真源,PNG 不入库)
xiaoan-coach-mascot-v1.png

# Skills 锁文件(本仓库不锁 skills 版本)
skills-lock.json

# 多 agent 适配器目录(与 .codex/.cursor 同类,本地保留)
.agents/

# 用户级插件 skills(非项目自带;openprd-* 仍入库)
.claude/skills/find-skills/
.claude/skills/lark-doc/
.claude/skills/lark-shared/

