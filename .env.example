# EasyPhone AI — 环境变量样例
# 复制为 .env.local 并填入真实值。.env.local 已被 .gitignore 排除,不会被提交。
# 所有变量 SERVER-ONLY(无 NEXT_PUBLIC_ 前缀) —— API key 永远不离开服务器。

# ===== Google Gemini API（Google AI Vibe-a-thon 参赛版） =====
# 在 Google AI Studio 创建。只能放在服务端环境变量，禁止 NEXT_PUBLIC_ 前缀。
GEMINI_API_KEY=

# 当前默认使用低延迟、支持结构化输出的 Gemini Flash。
GEMINI_MODEL=gemini-3.5-flash

# Gemini generateContent REST 模型根路径；通常无需修改。
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models

# AI 单次调用超时毫秒;超时即 fail-open(回退到关键词保险丝)。
# 线上模型偶有冷启动，8000ms 后自动回退到本地规则和模板。
AI_RECHECK_TIMEOUT_MS=8000

# AI 复检总开关。出问题时设 false 一键关 AI 兜底,产品退回到纯关键词模式。
# ENABLE_AI_RISK_RECHECK=true

# ===== M5 成本/滥用护栏(in-process,单实例) =====
# 10 分钟滑动窗口内最大 AI 调用次数;超过后 fail-open。默认 100。
# AI_RATE_LIMIT_PER_10MIN=100

# 单实例单日 AI 调用预算;超过后 fail-open(到 UTC 0 点重置)。默认 5000。
# 多实例部署(Next.js 多 worker / Vercel 多 region)各算各的;严格防滥用要换 Redis。
# AI_DAILY_BUDGET=5000
